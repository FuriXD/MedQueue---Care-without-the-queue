{"id":"sl/ofy9wn61","index":2,"title":"6/3/2026","elements":[{"position":{"left":-405.99,"top":-215.09,"width":738.01,"height":70.31}},{"position":{"left":25.66,"top":114.06,"width":1231.84,"height":597.48}},{"text":"6/3/2026","position":{"left":64,"top":667.33,"width":298.67,"height":38.33}},{"text":"BMSIT&M, CSE                                 ","position":{"left":437.33,"top":667.33,"width":405.33,"height":38.33}},{"text":"2","position":{"left":917.33,"top":667.33,"width":298.67,"height":38.33}},{"position":{"left":12.02,"top":197.77,"width":1194.15,"height":43.2}},{"position":{"left":66,"top":105,"width":8,"height":70}},{"text":"Introduction","position":{"left":100,"top":105,"width":1060,"height":55}},{"text":"Virtual queues reduce unnecessary waiting inside care facilities","position":{"left":102,"top":160,"width":1040,"height":30}},{"position":{"left":100,"top":198,"width":1050,"height":2}},{"text":"•","position":{"left":125,"top":230,"width":22,"height":30}},{"text":"Hospitals and diagnostic centers often face congestion at registration, consultation, labs, pharmacy, and billing.","position":{"left":159,"top":230,"width":946,"height":66}},{"text":"•","position":{"left":125,"top":300,"width":22,"height":30}},{"text":"Long physical queues delay care, strain staff, and increase infection exposure for vulnerable patients.","position":{"left":159,"top":300,"width":946,"height":66}},{"text":"•","position":{"left":125,"top":370,"width":22,"height":30}},{"text":"MediFlow gives patients a digital token, estimated waiting time, and arrival recommendation.","position":{"left":159,"top":370,"width":946,"height":66}},{"text":"•","position":{"left":125,"top":440,"width":22,"height":30}},{"text":"A live dashboard helps staff see queue growth, service delays, capacity, and crowding risk.","position":{"left":159,"top":440,"width":946,"height":66}}]}
{"id":"sl/jyx0ra1s","index":3,"title":"6/3/2026","elements":[{"position":{"left":-405.99,"top":-215.09,"width":738.01,"height":70.31}},{"position":{"left":25.66,"top":114.06,"width":1231.84,"height":597.48}},{"text":"6/3/2026","position":{"left":64,"top":667.33,"width":298.67,"height":38.33}},{"text":"BMSIT&M, CSE                                 ","position":{"left":437.33,"top":667.33,"width":405.33,"height":38.33}},{"text":"2","position":{"left":917.33,"top":667.33,"width":298.67,"height":38.33}},{"position":{"left":12.02,"top":197.77,"width":1194.15,"height":43.2}},{"position":{"left":66,"top":105,"width":8,"height":70}},{"text":"Problem Statement","position":{"left":100,"top":105,"width":1060,"height":55}},{"text":"Manual and first-come-first-served queues cannot adapt to clinical reality","position":{"left":102,"top":160,"width":1040,"height":30}},{"position":{"left":100,"top":198,"width":1050,"height":2}},{"text":"•","position":{"left":125,"top":230,"width":22,"height":30}},{"text":"Urgency, age risk, appointments, walk-ins, and emergency cases require different treatment.","position":{"left":159,"top":230,"width":946,"height":66}},{"text":"•","position":{"left":125,"top":300,"width":22,"height":30}},{"text":"Doctor delays and variable consultation times make static appointment registers unreliable.","position":{"left":159,"top":300,"width":946,"height":66}},{"text":"•","position":{"left":125,"top":370,"width":22,"height":30}},{"text":"Patients move through dependent stages such as registration, consultation, lab testing, and pharmacy.","position":{"left":159,"top":370,"width":946,"height":66}},{"text":"•","position":{"left":125,"top":440,"width":22,"height":30}},{"text":"Administrators lack early warning when peak-hour demand exceeds seating or service capacity.","position":{"left":159,"top":440,"width":946,"height":66}}]}
